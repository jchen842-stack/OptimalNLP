+# Size-bounded beam fallback (paper Sec 3.3 escape hatch). None => disabled, i.e. exact
+# optimal search with an unbounded frontier. Set to an int N to cap the frontier at N nodes:
+# under token-like concept overlap the admissible ceilings stop separating candidates, so the
+# frontier grows unbounded (OOM). Keeping only the top-N nodes by ceiling bounds memory and
+# time, trading exactness for tractability (the search degrades gracefully toward beam).
+MAX_FRONTIER_SIZE = None
+
+
+def _apply_beam_cap(frontier):
+    """If MAX_FRONTIER_SIZE is set and the frontier exceeds it, keep only the top-N nodes by
+    ceiling (highest estimated IoU == smallest -iou) and re-heapify. Selection uses only the
+    ceiling key so it never depends on tie-breaking the rest of the node tuple."""
+    if MAX_FRONTIER_SIZE is None or len(frontier) <= MAX_FRONTIER_SIZE:
+        return frontier
+    kept = heapq.nsmallest(MAX_FRONTIER_SIZE, frontier, key=lambda node: node[0])
+    heapq.heapify(kept)
+    return kept
+
+
